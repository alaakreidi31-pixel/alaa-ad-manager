{
  "name": "@alaa/api",
  "version": "0.0.0",
  "private": true,
  "description": "Backend API (NestJS)",
  "scripts": {
    "dev": "prisma generate && nest start --watch",
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "test": "vitest run",
    "test:db": "prisma generate && vitest run --config vitest.db.config.ts",
    "test:rollback": "prisma generate && vitest run --config vitest.rollback.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "dotenv": "^17.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/node": "^22.0.0",
    "prisma": "^7.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.0"
  }
}
