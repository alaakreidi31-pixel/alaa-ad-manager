// ALAA AD MANAGER - database schema
// Tables and columns use snake_case in PostgreSQL (@@map / @map),
// camelCase in TypeScript.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// TEAM_MEMBER is postponed (owner decision). Adding it later is a small migration.
enum UserRole {
  SUPER_ADMIN
  CLIENT_USER

  @@map("user_role")
}

// Users are never deleted: they are suspended (keeps the audit history).
enum UserStatus {
  ACTIVE
  SUSPENDED

  @@map("user_status")
}

model User {
  // UUID generated by PostgreSQL (gen_random_uuid is built into PostgreSQL 13+)
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Always stored trimmed and lowercase (see the CHECK constraint in the migration)
  email        String     @unique
  fullName     String     @map("full_name")
  // Hash only (argon2, step 1.2) - never a plain password
  passwordHash String     @map("password_hash")
  role         UserRole
  status       UserStatus @default(ACTIVE)
  // timestamptz: an exact instant, stored in UTC (ADR 0007)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("users")
}
