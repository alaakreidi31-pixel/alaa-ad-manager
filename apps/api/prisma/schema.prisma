// ALAA AD MANAGER - database schema
// Tables and columns use snake_case in PostgreSQL (@@map / @map),
// camelCase in TypeScript.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// TEAM_MEMBER is postponed (owner decision). Adding it later is a small migration.
enum UserRole {
  SUPER_ADMIN
  CLIENT_USER

  @@map("user_role")
}

// Users are never deleted: they are suspended (keeps the audit history).
enum UserStatus {
  ACTIVE
  SUSPENDED

  @@map("user_status")
}

model User {
  // UUID generated by PostgreSQL (gen_random_uuid is built into PostgreSQL 13+)
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Always stored trimmed and lowercase (see the CHECK constraint in the migration)
  email        String     @unique
  fullName     String     @map("full_name")
  // Hash only (argon2, step 1.2) - never a plain password
  passwordHash String     @map("password_hash")
  role         UserRole
  status       UserStatus @default(ACTIVE)
  // timestamptz: an exact instant, stored in UTC (ADR 0007)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  // Brute-force protection (ADR 0012): consecutive wrong passwords, and
  // the time until which login is refused after too many of them.
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(3)
  // Two-factor authentication (ADR 0013). The TOTP secret is stored
  // encrypted (AES-256-GCM), never in plain text. Both are set together
  // (CHECK constraint in the migration). Mandatory for SUPER_ADMIN.
  totpSecretEncrypted String?   @map("totp_secret_encrypted")
  totpEnabledAt       DateTime? @map("totp_enabled_at") @db.Timestamptz(3)
  // Time step of the last accepted code: the same code is never accepted twice.
  totpLastUsedStep    Int?      @map("totp_last_used_step")
  // Client accounts (ADR 0016): every CLIENT_USER belongs to exactly ONE
  // client; a SUPER_ADMIN to none (CHECK constraint in the migration).
  clientId           String?  @map("client_id") @db.Uuid
  client             Client?  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  // Set for a temporary password: no session until a new password is chosen.
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  sessions      Session[]
  recoveryCodes RecoveryCode[]

  @@index([clientId])
  @@map("users")
}

// One row per login. The refresh token itself is never stored: only its
// SHA-256 hash. Sessions are revoked, never deleted (audit history).
model Session {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  refreshTokenHash String    @unique @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  // Set on logout, on rotation (refresh), and when token reuse is detected
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  // The session that replaced this one after a refresh
  replacedById     String?   @map("replaced_by_id") @db.Uuid

  @@index([userId])
  @@map("sessions")
}

// One-time backup codes for two-factor login (ADR 0013). Only the SHA-256
// hash is stored. A used code keeps its row (used_at is set) until 2FA is
// set up again, which replaces all of them.
model RecoveryCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  codeHash  String    @map("code_hash")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("recovery_codes")
}

// Security audit log (ADR 0014). APPEND-ONLY: the application user (alaa_app)
// may only INSERT and SELECT; UPDATE and DELETE are revoked in the migration.
// No foreign key to users on purpose: the history must outlive any change to
// the accounts, and must never block one.
model AuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  // What happened, e.g. "auth.login.failed" (list in src/audit/audit.ts)
  action    String
  // The account concerned; null when unknown (e.g. login with an unknown email)
  userId    String?  @map("user_id") @db.Uuid
  ip        String?
  userAgent String?  @map("user_agent")
  // Extra details (e.g. the failure reason). Never a password, token or code.
  metadata  Json?

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// Clients are never deleted (owner decision): they are ARCHIVED.
// The application database user cannot DELETE rows (see the migration).
enum ClientStatus {
  ACTIVE
  // Temporarily blocked: no login, no services (ADR 0016)
  SUSPENDED
  // Finished relationship: read-only, history kept forever
  ARCHIVED

  @@map("client_status")
}

// A client company of the agency (ADR 0016).
model Client {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Company or brand name
  name             String
  contactName      String?      @map("contact_name")
  // Contact email (not a login: client logins are users, step 2.2)
  email            String?
  phone            String?
  // ISO 3166-1 alpha-2, e.g. "SA"
  country          String?      @db.Char(2)
  // ISO 4217, e.g. "USD" (ADR 0008)
  currency         String       @default("USD") @db.Char(3)
  // IANA time zone, e.g. "Asia/Riyadh", for the client's reports
  timezone         String       @default("UTC")
  website          String?
  businessIndustry String?      @map("business_industry")
  status           ClientStatus @default(ACTIVE)
  // SECRET: for the agency only. Never returned by any client-facing API.
  internalNotes    String?      @map("internal_notes")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  // Login accounts of this client (step 2.2)
  users            User[]
  // Meta and Google campaigns of this client (ADR 0018)
  campaigns        Campaign[]
  // Fee plans of this client, history included (ADR 0019)
  feePlans         FeePlan[]

  @@index([status, createdAt])
  @@map("clients")
}

// Advertising platform of a campaign (ADR 0018).
enum CampaignPlatform {
  META
  GOOGLE

  @@map("campaign_platform")
}

// Campaigns are never deleted (like clients): they are ARCHIVED.
enum CampaignStatus {
  ACTIVE
  PAUSED
  // Finished: its numbers stay in the reports
  ENDED
  // Hidden from the lists, read-only
  ARCHIVED

  @@map("campaign_status")
}

// A Meta or Google campaign run by the agency for a client (ADR 0018).
model Campaign {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId    String           @map("client_id") @db.Uuid
  client      Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  platform    CampaignPlatform
  name        String
  // The campaign id on Meta or Google; unique per client and platform
  // (partial unique index in the migration). Used by the CSV import.
  externalId  String?          @map("external_id")
  // Free text, e.g. "Leads" or "Sales"
  objective   String?
  status      CampaignStatus   @default(ACTIVE)
  // ISO 4217 currency of the ad account (may differ from the client's)
  currency    String           @db.Char(3)
  // Smallest unit of the currency, e.g. cents: 150.50 USD = 15050 (ADR 0008)
  dailyBudgetMinor BigInt?     @map("daily_budget_minor")
  startDate   DateTime?        @map("start_date") @db.Date
  endDate     DateTime?        @map("end_date") @db.Date
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  // One row per day (step 4.2)
  metrics     CampaignDailyMetric[]

  @@index([clientId, status])
  @@map("campaigns")
}

// Where a daily number came from (ADR 0018).
enum MetricSource {
  MANUAL
  CSV

  @@map("metric_source")
}

// The numbers of ONE campaign for ONE day (ADR 0018). Saving the same day
// again corrects the row: an imported file can never count a day twice.
// Never deleted: a wrong day is corrected (with zeros if needed).
model CampaignDailyMetric {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId  String       @map("campaign_id") @db.Uuid
  campaign    Campaign     @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  date        DateTime     @db.Date
  // Minor units of the CAMPAIGN currency (ADR 0008)
  spendMinor  BigInt       @default(0) @map("spend_minor")
  impressions BigInt       @default(0)
  clicks      BigInt       @default(0)
  // Not money: may be fractional (Google attribution, e.g. 2.5)
  conversions Decimal      @default(0) @db.Decimal(14, 2)
  source      MetricSource
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([campaignId, date])
  @@map("campaign_daily_metrics")
}

// ISO 4217 currencies with their minor units (ADR 0019). Read only for the
// application; the same list as src/money/currencies.ts (checked by a test).
model Currency {
  code       String    @id @db.Char(3)
  minorUnits Int       @map("minor_units") @db.SmallInt
  feePlans   FeePlan[]

  @@map("currencies")
}

// The agency fees of a client for a period of whole months (ADR 0019).
// Enforced by PostgreSQL (see the migration): no overlap between active
// plans (exclusion constraint), terms never change, closed once at the end
// of the current month at the earliest, cancelled only before it starts,
// never deleted.
model FeePlan {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId           String    @map("client_id") @db.Uuid
  client             Client    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  currency           String    @db.Char(3)
  currencyRef        Currency  @relation(fields: [currency], references: [code], onDelete: Restrict, onUpdate: Restrict)
  // Minor units (cents): 300.00 USD = 30000 (ADR 0008)
  fixedFeeMinor      BigInt    @default(0) @map("fixed_fee_minor")
  // Basis points: 10% = 1000, 7.5% = 750
  percentBasisPoints Int       @default(0) @map("percent_basis_points")
  // Applies to the TOTAL (fixed + percentage); null = no minimum
  minimumFeeMinor    BigInt?   @map("minimum_fee_minor")
  // First day of a month
  startsOn           DateTime  @map("starts_on") @db.Date
  // Last day of a month; null = still running
  endsOn             DateTime? @map("ends_on") @db.Date
  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([clientId, startsOn])
  @@map("fee_plans")
}
