# ALAA AD MANAGER - API environment variables
# 1) Copy this file to ".env" in the same folder (apps/api/.env)
# 2) Replace every CHANGE_ME with the real password of that database user
# NEVER commit .env - it is protected by .gitignore

NODE_ENV=development

# Development: 127.0.0.1 = reachable from this computer only
HOST=127.0.0.1
PORT=3000

# Signs access tokens. Generate it with the command in docs/development.md
# (random, 32+ characters). Never reuse it between environments.
JWT_ACCESS_SECRET=CHANGE_ME

# Encrypts the two-factor (2FA) secrets stored in the database (ADR 0013).
# 32 random bytes in base64: generate it with the command in docs/development.md.
# If it is lost, 2FA must be set up again (pnpm admin:setup-2fa).
TOTP_ENCRYPTION_KEY=CHANGE_ME

# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Used by the running API: alaa_app can read and write data only
DATABASE_URL="postgresql://alaa_app:CHANGE_ME@localhost:5432/alaa_ad_manager_dev"

# Used by Prisma migrations only: alaa_migrator owns the database structure
MIGRATE_DATABASE_URL="postgresql://alaa_migrator:CHANGE_ME@localhost:5432/alaa_ad_manager_dev"

# Database tests only (pnpm test:db). Both MUST point to a database whose
# name ends with "_test": the tests refuse to run otherwise.
TEST_DATABASE_URL="postgresql://alaa_app:CHANGE_ME@localhost:5432/alaa_ad_manager_test"
TEST_MIGRATE_DATABASE_URL="postgresql://alaa_migrator:CHANGE_ME@localhost:5432/alaa_ad_manager_test"
